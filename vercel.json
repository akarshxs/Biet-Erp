{
  "version": 2,
  "buildCommand": "corepack pnpm --filter @workspace/college-erp build",
  "outputDirectory": "artifacts/college-erp/dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://biet-erp-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
